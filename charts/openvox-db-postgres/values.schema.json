{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "database": {
            "type": "string"
        },
        "instances": {
            "type": "integer",
            "minimum": 1
        },
        "postInitSQL": {
            "type": "array"
        },
        "storage": {
            "type": "object",
            "properties": {
                "size": {
                    "type": "string"
                },
                "storageClass": {
                    "type": "string"
                }
            }
        }
    }
}
