{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "ca": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "storage": {
                    "type": "object",
                    "properties": {
                        "size": {
                            "type": "string"
                        },
                        "storageClass": {
                            "type": "string"
                        }
                    }
                },
                "ttl": {
                    "type": "string"
                }
            }
        },
        "config": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "object",
                    "properties": {
                        "claimName": {
                            "type": "string"
                        },
                        "image": {
                            "type": "string"
                        },
                        "imagePullPolicy": {
                            "type": "string",
                            "enum": [
                                "Always",
                                "IfNotPresent",
                                "Never"
                            ]
                        },
                        "imagePullSecret": {
                            "type": "string"
                        }
                    }
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "pullPolicy": {
                            "type": "string",
                            "enum": [
                                "Always",
                                "IfNotPresent",
                                "Never"
                            ]
                        },
                        "pullSecrets": {
                            "type": "array"
                        },
                        "repository": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "name": {
                    "type": "string"
                },
                "puppet": {
                    "type": "object",
                    "properties": {
                        "environmentPath": {
                            "type": "string"
                        },
                        "environmentTimeout": {
                            "type": "string"
                        },
                        "extraConfig": {
                            "type": "object"
                        },
                        "hieraConfig": {
                            "type": "string"
                        },
                        "reports": {
                            "type": "string"
                        },
                        "storeBackend": {
                            "type": "string"
                        },
                        "storeconfigs": {
                            "type": "boolean"
                        }
                    }
                },
                "puppetdb": {
                    "type": "object",
                    "properties": {
                        "serverUrls": {
                            "type": "array"
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                }
            }
        },
        "database": {
            "type": "object",
            "properties": {
                "certificate": {
                    "type": "object",
                    "properties": {
                        "certname": {
                            "type": "string"
                        },
                        "dnsAltNames": {
                            "type": "array"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "pullPolicy": {
                            "type": "string",
                            "enum": [
                                "Always",
                                "IfNotPresent",
                                "Never"
                            ]
                        },
                        "repository": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "javaArgs": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "postgres": {
                    "type": "object",
                    "properties": {
                        "credentialsSecretRef": {
                            "type": "string"
                        },
                        "database": {
                            "type": "string"
                        },
                        "host": {
                            "type": "string"
                        },
                        "port": {
                            "type": "integer",
                            "maximum": 65535,
                            "minimum": 1
                        },
                        "sslMode": {
                            "type": "string",
                            "enum": [
                                "disable",
                                "allow",
                                "prefer",
                                "require",
                                "verify-ca",
                                "verify-full"
                            ]
                        }
                    }
                },
                "replicas": {
                    "type": "integer",
                    "minimum": 1
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "gateway": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "sectionName": {
                    "type": "string"
                }
            }
        },
        "nodeClassifier": {
            "type": "object",
            "properties": {
                "auth": {
                    "type": "object",
                    "properties": {
                        "mtls": {
                            "type": "boolean"
                        }
                    }
                },
                "cache": {
                    "type": "object",
                    "properties": {
                        "directory": {
                            "type": "string"
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "request": {
                    "type": "object",
                    "properties": {
                        "body": {
                            "type": "string"
                        },
                        "method": {
                            "type": "string"
                        },
                        "path": {
                            "type": "string"
                        }
                    }
                },
                "response": {
                    "type": "object",
                    "properties": {
                        "format": {
                            "type": "string",
                            "enum": [
                                "yaml",
                                "json"
                            ]
                        }
                    }
                },
                "timeoutSeconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "pools": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "service": {
                        "type": "object",
                        "properties": {
                            "port": {
                                "type": "integer"
                            },
                            "type": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "reportProcessors": {
            "type": "array"
        },
        "servers": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "ca": {
                        "type": "boolean"
                    },
                    "certificate": {
                        "type": "object",
                        "properties": {
                            "certname": {
                                "type": "string"
                            },
                            "dnsAltNames": {
                                "type": "array"
                            }
                        }
                    },
                    "name": {
                        "type": "string"
                    },
                    "poolRefs": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "replicas": {
                        "type": "integer"
                    },
                    "resources": {
                        "type": "object",
                        "properties": {
                            "limits": {
                                "type": "object",
                                "properties": {
                                    "memory": {
                                        "type": "string"
                                    }
                                }
                            },
                            "requests": {
                                "type": "object",
                                "properties": {
                                    "cpu": {
                                        "type": "string"
                                    },
                                    "memory": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "server": {
                        "type": "boolean"
                    }
                }
            }
        },
        "signingPolicies": {
            "type": "array"
        }
    }
}
